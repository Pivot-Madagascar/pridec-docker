#copy to .env and fill in with values specific to your workflow

# generally leave these as is until you are ready to truly update data
DRYRUN='True'
LOG_LEVEL='DEBUG'

# CLI only (`docker compose run etl ...`). etlhub ignores them: it uses the DHIS2 token
# created at the etlui login. Never add DHIS_ENV_FALLBACK here: it is set in compose.yaml.
DHIS_URL="your-url"
DHIS_TOKEN="your-token"

#id of parent orgUnit. Ifanadiana: "VtP4BdCeXIo"
PARENT_OU="VtP4BdCeXIo" 
#hierarchy level of orgUnit you are focused on
#for Ifanadiana, 6 = fokontany, 5 = CSB
OU_LEVEL='5'
DISEASE_CODE="pridec_historic_yourDataElement" #corresponds to DHIS2 dataElement code of disease to predict

#for importing GEE data
GEE_PROJECT = "YOUR_GEE_PROJECT_NAME"
GEE_SERVICE_ACCOUNT="YOUR_SERVICE_ACCOUNT@YOUR_CLOUD_PROJECT.iam.gserviceaccount.com"
GEE_VARIABLES="pridec_climate_var1,pridec_climate_var2"

#the below is only needed for Pivot-specific workflows to update DHIS2 data
PIVOT_URL="pivot-production-url"
PIVOT_TOKEN="your-token-for-pivot-instance"

# etlui login (DHIS2 username/password -> 24h DHIS2 token kept by etlhub)
# Comma-separated host[:port] the login may send credentials to. Empty = every login is refused.
# https is required, except for localhost.
DHIS2_ALLOWED_HOSTS="localhost:8082"
DHIS2_AUTH_TIMEOUT=10.0
# Session cookie sent over https only. Set to false only for local http development.
COOKIE_SECURE=true

# Frontend URL, for CORS and the Origin check on POST/PUT/PATCH/DELETE
FRONTEND_URL="http://localhost:5173"

# Redis configuration (for JobStore, RequestTracker, ConfigStore)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
# Must match requirepass in redis-secret.conf (see redis.conf)
REDIS_PASSWORD="change-me"

# Comma-separated list of endpoints to track (empty = track all)
TRACKED_ENDPOINTS=""